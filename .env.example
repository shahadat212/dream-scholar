# Copy this file to .env and fill in your own values.
# Get these from your Firebase project settings (Project settings > General > Your apps).

VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=

# Backend base URL. Not required yet - the app currently runs on mock
# data and isn't calling the server. Used once we wire the two together.
VITE_API_URL=http://localhost:5000
